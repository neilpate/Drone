(version 1)
#----------------------------------------------------------------------------------------------------
# PCBWay custom DRC rules (Standard spec, 4-layer FR-4, green solder mask).
# Sourced from https://www.pcbway.com/capabilities.html (checked 2026-09).
# Supplements the board setup + Default net class (min trace/clearance 0.15 mm).
# Replaces the earlier AISLER rules per ADR 0028 (fab is now PCBWay).
#----------------------------------------------------------------------------------------------------

# Plated through holes: PCBWay standard drills 0.20-6.00 mm.
(rule "PTH drill size (PCBWay)"
    (constraint hole_size (min 0.2mm) (max 6.0mm))
    (condition "A.Pad_Type == 'Through-hole'"))

#----------------------------------------------------------------------------------------------------
# PCBWay standard (non-Advanced) has no blind/buried or micro vias.

(rule "Disallow buried via"
    (constraint disallow buried_via))

(rule "Disallow micro via"
    (constraint disallow micro_via))

#----------------------------------------------------------------------------------------------------
# Solder mask: PCBWay green-ink dam min 0.1 mm (4 mil); mask expansion min 0.05 mm (2 mil).
# The 0.5 mm-pitch ICM-42688-P (U4) leaves a ~0.05 mm inter-pad web, below the dam min, so U4
# carries the "allow soldermask bridges" attribute (mask gangs across its pads). Standard for
# fine-pitch LGA under reflow; no separate DRU rule needed.
#----------------------------------------------------------------------------------------------------
