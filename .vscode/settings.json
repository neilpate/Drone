{
    // ---------------------------------------------------------------------
    // rust-analyzer: mixed-target workspace configuration
    // ---------------------------------------------------------------------
    //
    // Focus this window on the nRF5340 app. Workspace-wide Cargo checks would
    // combine its Embassy chip feature with the micro:bit's nRF52833 feature.
    // Open the other firmware or groundstation separately when working on it.
    "rust-analyzer.cargo.target": "thumbv8m.main-none-eabihf",
    "rust-analyzer.linkedProjects": [
        "crates/firmware-drone-nrf5340-app/Cargo.toml"
    ],
    "rust-analyzer.cargo.allTargets": false,
    "rust-analyzer.cargo.buildScripts.overrideCommand": [
        "cargo", "check", "-p", "firmware-drone-nrf5340-app",
        "--target", "thumbv8m.main-none-eabihf", "--message-format=json"
    ],
    "rust-analyzer.check.overrideCommand": [
        "cargo", "clippy", "-p", "firmware-drone-nrf5340-app",
        "--target", "thumbv8m.main-none-eabihf", "--message-format=json",
        "--", "-D", "warnings"
    ],
    // Populate VS Code's native Testing view (beaker icon) with discovered
    // `#[test]` functions. Experimental in rust-analyzer but stable enough.
    // CodeLens run arrows work independently of this.
    "rust-analyzer.testExplorer": true,
    // ---------------------------------------------------------------------
    // Formatting
    // ---------------------------------------------------------------------
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "[toml]": {
        "editor.formatOnSave": false
    },
    // The Even Better TOML extension ships a stale Cargo schema that flags
    // valid `[lints.rust]` / `[lints.clippy]` sub-tables as errors. Cargo
    // itself validates on build, so the schema is cosmetic — turn it off
    // workspace-wide rather than play whack-a-mole as Cargo evolves.
    "evenBetterToml.schema.enabled": false,
    // ---------------------------------------------------------------------
    // Files
    // ---------------------------------------------------------------------
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "memory.x": "linker-script",
        "*.x": "linker-script"
    }
}
